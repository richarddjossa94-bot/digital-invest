
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#080d0a">
<title>Digital Invest</title>
<style>
:root {
  --bg:#080d0a; --card:#111a14; --card2:#19251c;
  --green:#45e69a; --green2:#153c29; --white:#f4faf5;
  --muted:#94a69a; --border:#26372b; --red:#ff9696;
}
* { box-sizing:border-box; }
body {
  margin:0; background:var(--bg); color:var(--white);
  font-family:Arial,Helvetica,sans-serif; line-height:1.45;
}
button,input,select { font:inherit; }
button { cursor:pointer; }
button:disabled { opacity:.6; cursor:wait; }
[hidden] { display:none!important; }
.top {
  position:sticky; top:0; z-index:20;
  background:#080d0af5; border-bottom:1px solid var(--border);
  backdrop-filter:blur(12px);
}
.top-inner {
  max-width:1050px; margin:auto; padding:15px 16px;
  display:flex; justify-content:space-between; align-items:center; gap:12px;
}
.logo { font-weight:900; font-size:22px; letter-spacing:-.7px; }
.logo span { color:var(--green); }
.avatar {
  width:38px; height:38px; display:grid; place-items:center;
  border-radius:50%; background:var(--green2); color:var(--green);
  border:1px solid #2d6346; font-weight:bold;
}
.container { max-width:1050px; width:calc(100% - 28px); margin:20px auto 35px; }
.page { display:none; }
.page.active { display:block; }
.muted { color:var(--muted); }
.small { font-size:12px; }
h1 { font-size:27px; line-height:1.2; margin:6px 0 15px; }
h2 { font-size:19px; margin:0 0 13px; }
h3 { font-size:15px; margin:0 0 7px; }
p { margin:7px 0 12px; }
.section-head {
  display:flex; justify-content:space-between; align-items:center;
  gap:10px; margin:23px 0 12px;
}
.section-head h2 { margin:0; }
.link-btn { border:0; background:none; color:var(--green); padding:6px 0; }
.hero {
  border:1px solid #285039; border-radius:20px; padding:22px;
  background:radial-gradient(ellipse at top right,#1a5537 0%,transparent 60%),
             linear-gradient(140deg,#14281b,#0f1711);
}
.eyebrow { color:var(--green); text-transform:uppercase; letter-spacing:1.5px; font-size:10px; font-weight:bold; }
.balance-label { color:#c0d5c6; font-size:13px; }
.balance { font-size:clamp(29px,7vw,38px); font-weight:800; margin:8px 0 3px; }
.balance small { font-size:15px; }
.badge {
  display:inline-flex; padding:5px 9px; border-radius:20px;
  background:#163b29; color:#9af2bf; font-size:10px;
}
.grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:10px; }
.actions { margin-top:17px; }
.action {
  border:1px solid var(--border); border-radius:14px;
  background:var(--card); color:var(--white); padding:13px 4px;
  text-align:center; min-width:0;
}
.action:hover { border-color:var(--green); background:var(--card2); }
.action-icon {
  width:43px; height:43px; margin:0 auto 8px;
  display:grid; place-items:center; border-radius:13px;
  background:var(--green2); color:var(--green); font-size:23px;
}
.action span:last-child { display:block; font-size:11px; }
.card {
  min-width:0; background:var(--card); border:1px solid var(--border);
  border-radius:15px; padding:15px;
}
.cards2 { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
.product-image {
  width:100%; height:112px; object-fit:cover; border-radius:10px;
  background:var(--card2); display:block; margin-bottom:11px;
}
.product-price { color:var(--green); font-weight:bold; font-size:15px; }
.btn {
  border:1px solid var(--border); border-radius:9px;
  background:var(--card2); color:var(--white); padding:11px 13px;
  text-align:center; font-weight:bold; font-size:13px;
}
.btn.primary { background:var(--green); color:#07150c; border-color:var(--green); }
.btn.full { width:100%; }
.btn-row { display:flex; flex-wrap:wrap; gap:8px; margin-top:12px; }
.stat-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
.stat-number { color:var(--green); font-weight:bold; font-size:22px; margin-top:7px; }
.stat-label { color:var(--muted); font-size:12px; }
.list-row {
  display:flex; align-items:center; justify-content:space-between; gap:12px;
  padding:13px 0; border-bottom:1px solid var(--border);
}
.list-row:last-child { border-bottom:0; }
.list-icon {
  width:39px; height:39px; flex-shrink:0; display:grid; place-items:center;
  border-radius:12px; background:var(--green2); color:var(--green); font-size:19px;
}
.list-main { display:flex; align-items:center; gap:10px; min-width:0; }
.list-main p { margin:3px 0 0; font-size:11px; color:var(--muted); }
.amount { font-weight:bold; white-space:nowrap; font-size:13px; }
.notice {
  padding:12px 14px; border-radius:11px; background:#17261b;
  border:1px solid #304b36; color:#c9dfce; font-size:12px; margin-top:15px;
}
label { display:block; margin:13px 0 6px; color:var(--muted); font-size:12px; }
input,select {
  width:100%; border:1px solid var(--border); border-radius:9px;
  padding:12px; color:var(--white); background:#0a100c;
}
input:focus,select:focus { outline:1px solid var(--green); }
.form-card { max-width:460px; margin:15px auto; }
.message { overflow-wrap:anywhere; font-size:12px; color:var(--muted); }
.tag { color:var(--green); background:var(--green2); padding:4px 7px; border-radius:20px; font-size:10px; }
.bottom-nav {
  position:fixed; z-index:30; bottom:0; left:0; right:0;
  background:#0b120df7; border-top:1px solid var(--border);
  display:flex; justify-content:center; padding:7px 4px calc(7px + env(safe-area-inset-bottom));
}
.bottom-inner { width:100%; max-width:600px; display:grid; grid-template-columns:repeat(5,1fr); gap:2px; }
.bottom-nav button {
  border:0; border-radius:9px; background:none; color:var(--muted);
  padding:6px 1px; font-size:10px;
}
.bottom-nav button b { display:block; font-size:21px; font-weight:normal; margin-bottom:2px; }
.bottom-nav button.active { color:var(--green); background:var(--green2); }
footer { text-align:center; padding:20px 12px 105px; color:var(--muted); font-size:11px; }
@media(min-width:760px) {
  .container { margin-top:28px; }
  .hero { padding:30px; }
  .product-image { height:165px; }
  .bottom-nav { display:none; }
  footer { padding-bottom:25px; }
}
@media(max-width:360px) {
  .grid { gap:6px; }
  .action { padding:10px 2px; }
  .action-icon { width:37px; height:37px; }
  .action span:last-child { font-size:10px; }
}
</style>
</head>
<body>

<header class="top">
  <div class="top-inner">
    <a href="#" class="logo" data-page="home">Digital<span>Invest</span></a>
    <button class="avatar" data-page="profile" aria-label="Mon profil">DI</button>
  </div>
</header>

<main class="container">

  <!-- ACCUEIL -->
  <section class="page active" id="page-home">
    <div class="hero">
      <div class="eyebrow">Mon espace financier</div>
      <h1>Bonjour et bienvenue 👋</h1>
      <p class="balance-label">Solde de démonstration</p>
      <div class="balance">0 <small>FCFA</small></div>
      <span class="badge">● Version de démonstration</span>
      <div class="grid actions">
        <button class="action" data-page="operations">
          <span class="action-icon">↓</span><span>Dépôt</span>
        </button>
        <button class="action" data-page="operations">
          <span class="action-icon">↑</span><span>Retrait</span>
        </button>
        <button class="action" data-page="products">
          <span class="action-icon">◈</span><span>Produits</span>
        </button>
        <button class="action" data-page="history">
          <span class="action-icon">↻</span><span>Historique</span>
        </button>
      </div>
    </div>

    <div class="section-head">
      <h2>Vue d'ensemble</h2>
      <button class="link-btn" data-page="wallet">Voir tout →</button>
    </div>

    <div class="stat-grid">
      <div class="card">
        <div class="stat-label">Montant investi (démo)</div>
        <div class="stat-number">0 FCFA</div>
      </div>
      <div class="card">
        <div class="stat-label">Résultat fictif</div>
        <div class="stat-number">0 FCFA</div>
      </div>
    </div>

    <div class="section-head">
      <h2>Produits numériques</h2>
      <button class="link-btn" data-page="products">Explorer →</button>
    </div>

    <div class="cards2">
      <article class="card">
        <img class="product-image"
          src="https://images.unsplash.com/photo-1634017839464-5c339ebe3cb4?auto=format&fit=crop&w=600&q=80"
          alt="Illustration abstraite numérique"
          onerror="this.style.display='none'">
        <span class="tag">Exemple</span>
        <h3 style="margin-top:9px">Guide numérique</h3>
        <p class="muted small">Contenu éducatif à définir.</p>
        <div class="product-price">Prix à définir</div>
        <button class="btn full" style="margin-top:10px" data-page="products">Découvrir</button>
      </article>
      <article class="card">
        <img class="product-image"
          src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=600&q=80"
          alt="Illustration d'outils numériques"
          onerror="this.style.display='none'">
        <span class="tag">Exemple</span>
        <h3 style="margin-top:9px">Formation digitale</h3>
        <p class="muted small">Formation à définir.</p>
        <div class="product-price">Prix à définir</div>
        <button class="btn full" style="margin-top:10px" data-page="products">Découvrir</button>
      </article>
    </div>

    <div class="notice">
      Tous les soldes et résultats sont fictifs. Aucun argent n'est reçu,
      placé ou généré par cette démonstration.
    </div>
  </section>

  <!-- PRODUITS -->
  <section class="page" id="page-products">
    <div class="eyebrow">Catalogue</div>
    <h1>Produits numériques</h1>
    <p class="muted">Découvre les produits présentés sur la plateforme.</p>
    <div class="cards2">
      <article class="card">
        <img class="product-image"
          src="https://images.unsplash.com/photo-1634017839464-5c339ebe3cb4?auto=format&fit=crop&w=600&q=80"
          alt="Illustration numérique" onerror="this.style.display='none'">
        <span class="tag">Exemple</span>
        <h3 style="margin-top:9px">Guide numérique</h3>
        <p class="muted small">Description à compléter.</p>
        <div class="product-price">Prix à définir</div>
        <button class="btn full demo-product" style="margin-top:10px">Voir le détail</button>
      </article>
      <article class="card">
        <img class="product-image"
