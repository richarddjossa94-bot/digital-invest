<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0b0f17">
  <title>Digital Invest</title>

  <style>
    :root {
      --fond: #0b0f17;
      --carte: #151c29;
      --vert: #50e3a4;
      --texte: #f4f7fb;
      --gris: #aab4c5;
      --bordure: #283346;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: var(--fond);
      color: var(--texte);
      font-family: Arial, sans-serif;
      line-height: 1.6;
    }

    header {
      padding: 20px;
      border-bottom: 1px solid var(--bordure);
      text-align: center;
    }

    .logo {
      color: var(--vert);
      font-size: 25px;
      font-weight: bold;
    }

    .hero {
      padding: 55px 20px 35px;
      text-align: center;
    }

    .hero h1 {
      font-size: clamp(30px, 7vw, 45px);
      line-height: 1.2;
      margin-bottom: 15px;
    }

    .hero p {
      max-width: 600px;
      margin: 0 auto 20px;
      color: var(--gris);
    }

    .accent {
      color: var(--vert);
    }

    .conteneur {
      width: min(100% - 28px, 700px);
      margin: 25px auto;
    }

    .carte {
      background: var(--carte);
      border: 1px solid var(--bordure);
      border-radius: 16px;
      padding: 22px;
      margin-bottom: 20px;
    }

    h2, h3 {
      margin-top: 0;
    }

    .auth {
      max-width: 480px;
      margin: 25px auto;
    }

    label {
      display: block;
      margin: 14px 0 6px;
      color: var(--gris);
    }

    input {
      display: block;
      width: 100%;
      padding: 14px;
      background: #0d1320;
      color: white;
      border: 1px solid var(--bordure);
      border-radius: 9px;
      font-size: 16px;
    }

    button {
      width: 100%;
      padding: 13px;
      margin-top: 12px;
      border: 0;
      border-radius: 9px;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
    }

    .principal {
      background: var(--vert);
      color: #07140e;
    }

    .secondaire {
      background: #253247;
      color: white;
    }

    .deconnexion {
      background: #49252c;
      color: white;
    }

    button:disabled {
      opacity: 0.6;
      cursor: wait;
    }

    #di-message {
      margin-top: 15px;
      overflow-wrap: anywhere;
      color: var(--gris);
    }

    .grille {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 12px;
    }

    .stat {
      padding: 16px;
      border-radius: 12px;
      background: #0d1320;
      border: 1px solid var(--bordure);
    }

    .stat p {
      color: var(--gris);
      font-size: 14px;
      margin: 0 0 8px;
    }

    .montant {
      color: var(--vert);
      font-size: 22px;
      font-weight: bold;
      overflow-wrap: anywhere;
    }

    .note {
      color: var(--gris);
      font-size: 13px;
    }

    .fonction {
      margin-bottom: 12px;
      padding: 15px;
      background: #0d1320;
      border-radius: 10px;
    }

    footer {
      text-align: center;
      color: var(--gris);
      padding: 25px 15px;
      border-top: 1px solid var(--bordure);
      font-size: 13px;
    }

    [hidden] {
      display: none !important;
    }
  </style>
</head>

<body>

  <header>
    <div class="logo">Digital Invest</div>
    <div class="note">Espace numérique de démonstration</div>
  </header>

  <main>
    <section class="hero">
      <h1>Bienvenue sur <span class="accent">Digital Invest</span></h1>
      <p>
        Découvre notre espace numérique et accède à ton tableau de bord
        personnel après connexion.
      </p>
    </section>

    <section class="conteneur carte">
      <h2>Comment ça fonctionne ?</h2>

      <div class="fonction">
        <strong>01 — Crée ton compte</strong>
        <div class="note">Inscris-toi avec ton adresse e-mail.</div>
      </div>

      <div class="fonction">
        <strong>02 — Connecte-toi</strong>
        <div class="note">Accède à ton espace personnel.</div>
      </div>

      <div class="fonction">
        <strong>03 — Consulte ton tableau de bord</strong>
        <div class="note">
          Les données affichées pour le moment sont des exemples.
        </div>
      </div>
    </section>

    <!-- FORMULAIRE DE CONNEXION -->
    <section class="conteneur carte auth" id="di-auth">
      <h2>Mon compte</h2>
      <p class="note">
        Crée un compte ou connecte-toi avec un compte existant.
      </p>

      <form id="di-form">
        <label for="di-email">Adresse e-mail</label>
        <input
          id="di-email"
          type="email"
          placeholder="exemple@email.com"
          autocomplete="email"
          required
        >

        <label for="di-password">Mot de passe</label>
        <input
          id="di-password"
          type="password"
          placeholder="Au moins 6 caractères"
          autocomplete="current-password"
          minlength="6"
          required
        >

        <button class="principal" id="di-signup" type="button">
          Créer mon compte
        </button>

        <button class="secondaire" id="di-login" type="submit">
          Me connecter
        </button>

        <button
          class="deconnexion"
          id="di-logout"
          type="button"
          hidden
        >
          Me déconnecter
        </button>
      </form>

      <p id="di-message" role="status" aria-live="polite">
        Vérification de la connexion...
      </p>
    </section>

    <!-- TABLEAU DE BORD : placé AVANT le script de connexion -->
    <section class="conteneur carte" id="di-dashboard" hidden>
      <h2>Mon tableau de bord</h2>
      <p>Bienvenue sur Digital Invest !</p>

      <div class="grille">
        <div class="stat">
          <p>Mon solde de démonstration</p>
          <div class="montant">0 FCFA</div>
        </div>

        <div class="stat">
          <p>Montant investi</p>
          <div class="montant">0 FCFA</div>
        </div>

        <div class="stat">
          <p>Bénéfices enregistrés</p>
          <div class="montant">0 FCFA</div>
        </div>
      </div>

      <h3 style="margin-top:25px">Historique des opérations</h3>
      <p id="di-history">Aucune opération pour le moment.</p>

      <p class="note">
        Ces chiffres sont fictifs et servent uniquement à tester le site.
        Aucun argent n'a été reçu, investi ou généré par cette page.
      </p>
    </section>

    <section class="conteneur carte">
      <h2>À propos</h2>
      <p class="note">
        Digital Invest est actuellement une démonstration technique.
        Les paiements réels, les investissements et les éventuels
        rendements ne sont pas activés.
      </p>
    </section>
  </main>

  <footer>
    Digital Invest — Version de démonstration
  </footer>

  <!-- Bibliothèque Supabase -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <script>
    (() => {
      "use strict";

      // Remplace ces deux valeurs par les informations publiques
      // de TON projet Supabase. N'utilise jamais une clé secrète ici.
      const SUPABASE_URL =
        "COLLE_ICI_URL_SUPABASE";

      const SUPABASE_KEY =
        "COLLE_ICI_CLE_PUBLISHABLE";

      const message = document.getElementById("di-message");
      const form = document.getElementById("di-form");
      const emailInput = document.getElementById("di-email");
      const passwordInput = document.getElementById("di-password");
      const signupButton = document.getElementById("di-signup");
      const loginButton = document.getElementById("di-login");
      const logoutButton = document.getElementById("di-logout");
      const dashboard = document.getElementById("di-dashboard");

      function showMessage(text) {
        message.textContent = text;
      }

      if (!window.supabase) {
        showMessage(
          "Erreur : la bibliothèque de connexion ne s'est pas chargée. Vérifie ta connexion Internet."
        );
        return;
      }

      if (
        SUPABASE_URL.includes("COLLE_ICI") ||
        SUPABASE_KEY.includes("COLLE_ICI")
      ) {
        showMessage(
          "Configuration manquante : ajoute l'URL et la clé publishable de Supabase dans le code."
        );
        return;
      }

      let client;

      try {
        client = window.supabase.createClient(
          SUPABASE_URL,
          SUPABASE_KEY
        );
      } catch (error) {
        showMessage("Impossible de préparer la connexion Supabase.");
        return;
      }

      let busy = false;

      function setBusy(value) {
        busy = value;
        signupButton.disabled = value;
        loginButton.disabled = value;
        logoutButton.disabled = value;
      }

      async function updateSession() {
        const { data, error } = await client.auth.getSession();

        if (error) {
          showMessage("Impossible de vérifier la connexion : " + error.message);
          return;
        }

        const session = data.session;
        const connected = Boolean(session);

        signupButton.hidden = connected;
        loginButton.hidden = connected;
        logoutButton.hidden = !connected;
        emailInput.disabled = connected;
        passwordInput.disabled = connected;
        dashboard.hidden = !connected;

        if (connected) {
          showMessage("Connecté : " + session.user.email);
        } else {
          showMessage("Tu n'es pas connecté.");
        }
      }

      async function authenticate(isSignup) {
        if (busy) return;

        const email = emailInput.value.trim();
        const password = passwordInput.value;

        if (!email || !password) {
          showMessage("Entre ton adresse e-mail et ton mot de passe.");
          return;
        }

        setBusy(true);
        showMessage(
          isSignup ? "Création du compte en cours..." : "Connexion en cours..."
        );

        try {
          let result;

          if (isSignup) {
            result = await client.auth.signUp({
              email: email,
              password: password
            });
          } else {
            result = await client.auth.signInWithPassword({
              email: email,
              password: password
            });
          }

          if (result.error) {
            showMessage("Erreur : " + result.error.message);
            return;
          }

          if (
            isSignup &&
            result.data.user &&
            !result.data.session
          ) {
            showMessage(
              "Compte créé. Vérifie ta boîte e-mail et confirme ton adresse avant de te connecter."
            );
            return;
          }

          showMessage(isSignup ? "Compte créé avec succès !" : "Connexion réussie !");
          await updateSession();

        } catch (error) {
          showMessage("Une erreur est survenue. Vérifie Internet et réessaie.");
        } finally {
          setBusy(false);
        }
      }

      signupButton.addEventListener("click", () => {
        authenticate(true);
      });

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        authenticate(false);
      });

      logoutButton.addEventListener("click", async () => {
        if (busy) return;

        setBusy(true);

        try {
          const { error } = await client.auth.signOut();

          if (error) {
            showMessage("Erreur de déconnexion : " + error.message);
            return;
          }

          passwordInput.value = "";
          showMessage("Tu es déconnecté.");
          await updateSession();

        } catch (error) {
          showMessage("La déconnexion a échoué. Réessaie.");
        } finally {
          setBusy(false);
        }
      });

      client.auth.onAuthStateChange((_event, session) => {
        const connected = Boolean(session);

        signupButton.hidden = connected;
        loginButton.hidden = connected;
        logoutButton.hidden = !connected;
        emailInput.disabled = connected;
        passwordInput.disabled = connected;
        dashboard.hidden = !connected;

        showMessage(
          connected
            ? "Connecté : " + session.user.email
            : "Tu n'es pas connecté."
        );
      });

      updateSession();
    })();
  </script>

</body>
</html>
