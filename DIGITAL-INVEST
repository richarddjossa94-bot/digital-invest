      <input id="withdraw-amount" type="number" min="1" placeholder="Ex. 2000">
      <label for="withdraw-method">Destination fictive</label>
      <select id="withdraw-method">
        <option>Mobile Money (démo)</option>
        <option>Compte bancaire (démo)</option>
      </select>
      <button class="btn full" id="withdraw-button" style="margin-top:14px">Tester le formulaire</button>
    </div>
    <div class="notice" id="operation-message" role="status">
      Aucun dépôt ou retrait réel n'est possible.
    </div>
  </section>

  <!-- HISTORIQUE -->
  <section class="page" id="page-history">
    <div class="eyebrow">Activité du compte</div>
    <h1>Historique</h1>
    <div class="card">
      <div class="list-row">
        <div class="list-main">
          <div class="list-icon">↻</div>
          <div><strong>Aucune opération</strong><p>Les opérations de démonstration ne sont pas enregistrées.</p></div>
        </div>
        <span class="tag">Vide</span>
      </div>
    </div>
    <div class="notice">L'historique ne contient aucune transaction réelle.</div>
  </section>

  <!-- PROFIL / AUTHENTIFICATION -->
  <section class="page" id="page-profile">
    <div class="eyebrow">Mon compte</div>
    <h1>Profil</h1>
    <div class="card form-card" id="di-auth">
      <h2>Connexion</h2>
      <p class="muted small">Connecte-toi ou crée ton compte.</p>
      <form id="di-form">
        <label for="di-email">Adresse e-mail</label>
        <input id="di-email" type="email" autocomplete="email" required placeholder="exemple@email.com">
        <label for="di-password">Mot de passe</label>
        <input id="di-password" type="password" minlength="6" autocomplete="current-password" required placeholder="Au moins 6 caractères">
        <div class="btn-row" style="display:grid">
          <button class="btn primary" id="di-login" type="submit">Me connecter</button>
          <button class="btn" id="di-signup" type="button">Créer mon compte</button>
          <button class="btn" id="di-logout" type="button" hidden>Me déconnecter</button>
        </div>
      </form>
      <p class="message" id="di-message" role="status" aria-live="polite">Vérification de la connexion...</p>
    </div>
    <div class="card" id="di-profile-info" hidden>
      <div class="list-row">
        <div class="list-main">
          <div class="list-icon">●</div>
          <div><strong>Mon compte</strong><p id="di-user-email"></p></div>
        </div>
        <span class="tag">Connecté</span>
      </div>
      <p class="muted small">Ton compte est connecté à Supabase. Les opérations financières restent en démonstration.</p>
      <button class="btn full" data-page="wallet">Ouvrir mon portefeuille</button>
    </div>
  </section>

</main>

